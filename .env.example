# Use forward slashes for Windows bind mounts.
RXN2_RAW_ROOT=I:/My Drive/RXN2/data/raw
RXN2_CLOUD_RESULTS_ROOT=I:/My Drive/RXN2/data/processed
RXN2_OCR_ROOT=I:/My Drive/UnlimitedOCR/output
RXN2_DB_PATH=/workspace/data/curated/rxn2-production.sqlite
RXN2_SEED_DEMO=false
# Large raw releases are processed in Colab; Windows may directly stream only
# bounded source files. Override only after measuring Drive cache behaviour.
RXN2_STREAM_MAX_BYTES=536870912

# EPO Open Patent Services (keep real values only in .env).
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=

# Public-patent relation extraction. Real keys belong only in .env.
OPENROUTER_API_KEY=
# A legacy local name, op_api_key, is also accepted. Only one key is used per run.
GROQ_API_KEY=
# The API refuses OpenRouter models without :free (or openrouter/free).
# Ordered fallback chain: all requests use the first configured model until it fails.
RELATION_OPENROUTER_MODELS=z-ai/glm-5.2:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
# Keep deny unless public-source text is explicitly approved for provider processing.
RELATION_OPENROUTER_DATA_COLLECTION=deny
# GLM uses provider-enforced strict JSON Schema. Fallbacks use JSON mode then the
# same local Pydantic schema, quote, offset, and chemistry validation gates.

RELATION_GROQ_MODEL=openai/gpt-oss-20b
RELATION_PROVIDER_CONCURRENCY=4
# Enable only after confirming the Groq project is on its free quota.
RELATION_ENABLE_GROQ_ADJUDICATOR=false

# Evidence-bound patent review agents. Their output remains needs_human_review.
PATENT_REVIEW_GROQ_MODEL=qwen/qwen3.6-27b
PATENT_REVIEW_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PATENT_REVIEW_TIMEOUT_SECONDS=120
PATENT_REVIEW_MAX_OUTPUT_TOKENS=4096
