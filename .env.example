# Use forward slashes for Windows bind mounts.
RXN2_RAW_ROOT=I:/My Drive/RXN2/data/raw
RXN2_CLOUD_RESULTS_ROOT=I:/My Drive/RXN2/data/processed
RXN2_OCR_ROOT=I:/My Drive/UnlimitedOCR/output
# Large raw releases are processed in Colab; Windows may directly stream only
# bounded source files. Override only after measuring Drive cache behaviour.
RXN2_STREAM_MAX_BYTES=536870912
